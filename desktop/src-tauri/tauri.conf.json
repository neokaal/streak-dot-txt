{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Streak.txt",
  "version": "0.1.1",
  "identifier": "in.neolateral.streaktxt",
  "build": {
    "frontendDist": "../web-shell",
    "devUrl": "http://127.0.0.1:8000"
  },
  "app": {
    "windows": [
      {
        "title": "Streak.txt",
        "width": 960,
        "height": 720,
        "minWidth": 420,
        "minHeight": 560
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "resources": {
      "resources/sidecar/": "sidecar/"
    }
  }
}
